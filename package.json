{
  "name": "keystroker",
  "version": "0.1.0",
  "description": "Premium typing and mouse click sound engine for Windows",
  "author": "Nihil",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:1420 && electron .\"",
    "start": "electron .",
    "build": "tsc && vite build",
    "build:win": "npm run build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.5",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wait-on": "^9.1.0"
  }
}
